# yaml-language-server: $schema=https://raw.githubusercontent.com/recyclarr/recyclarr/master/schemas/config-schema.json
#
# Recyclarr Configuration
# 
# What this handles:
#   - Quality profiles (prefer 1080p over 4K to save disk space)
#   - Custom formats (block fake releases, prefer good groups)
#   - Anti-virus protection (block ISOs, executables, suspicious releases)
#   - Resolution preferences (discourage 4K with negative scores)
#
# What Sonarr/Radarr handle automatically:
#   - Seeder/peer prioritization (automatically prefers releases with more seeders)
#   - Indexer scoring and reliability
#   - Failed download handling
#

sonarr:
  sonarr-main:
    base_url: http://{{ ansible_host }}:8989
    api_key: {{ sonarr_api_key }}
    
    # Apply TRaSH Guides quality definitions
    quality_definition:
      type: series
    
    # Quality profiles - HD prioritized to save disk space
    quality_profiles:
      - name: HD+
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: Bluray-1080p
          until_score: 10000
        min_format_score: 0
        quality_sort: top
        qualities:
          - name: Bluray-1080p
          - name: WEB 1080p
          - name: HDTV-1080p
          # 4K formats listed last (lower priority, fallback only)
          - name: Bluray-2160p
          - name: WEB 2160p
          - name: HDTV-2160p
      
      - name: Ultra-HD
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: false  # Don't upgrade if you have limited space
          until_score: 10000
        min_format_score: 0
        qualities:
          - name: Bluray-2160p
          - name: WEB 2160p
          - name: HDTV-2160p
    
    # CRITICAL: Anti-virus/fake release protection
    # These formats block: .iso, .exe, .rar, password-protected files, and known fake patterns
    custom_formats:
      # Block unwanted content - ISOs, executables, low quality groups
      - trash_ids:
          - 85c61753df5da1fb2aab6f2a47426b09  # BR-DISK (blocks .iso files)
          - 9c11cd3f07101cdba90a2d81cf0e56b4  # LQ (blocks .exe, bad groups)
          - e2315f990da2e2cbfc9fa5b7a6fcfe48  # LQ (Release Title - suspicious naming)
          - 32b367365729d530ca1c124a0b180c64  # Bad Dual Groups
        assign_scores_to:
          - name: HD+
            score: -10000  # Completely block these
          - name: Ultra-HD
            score: -10000
      
      # Block x265 HD (often low quality/fake)
      - trash_ids:
          - 47435ece6b99a0b477caf360e79ba0bb  # x265 (HD)
        assign_scores_to:
          - name: HD+
            score: -10000
      
      # Prefer good release groups
      - trash_ids:
          - d6819cba26b1a6508138d25fb5e32293  # Anime Web Tier 01 (Best)
          - d0c516558625b04b363fa6c5c2c7cfd4  # WEB Tier 01
          - e6258996055b9fbab7e9cb2f75819294  # WEB Tier 02
        assign_scores_to:
          - name: HD+
            score: 1500
          - name: Ultra-HD
            score: 1500

radarr:
  radarr-main:
    base_url: http://{{ ansible_host }}:7878
    api_key: {{ radarr_api_key }}
    
    # Apply TRaSH Guides quality definitions
    quality_definition:
      type: movie
    
    # Quality profiles - HD prioritized to save disk space
    quality_profiles:
      - name: HD+
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: Bluray-1080p
          until_score: 10000
        min_format_score: 0
        quality_sort: top
        qualities:
          - name: Bluray-1080p
          - name: Remux-1080p
          - name: WEB 1080p
          - name: HDTV-1080p
          # 4K formats listed last (lower priority, fallback only)
          - name: Bluray-2160p
          - name: Remux-2160p
          - name: WEB 2160p
          - name: HDTV-2160p
      
      - name: Ultra-HD
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: false  # Don't upgrade if you have limited space
          until_score: 10000
        min_format_score: 0
        qualities:
          - name: Bluray-2160p
          - name: Remux-2160p
          - name: WEB 2160p
          - name: HDTV-2160p
    
    # CRITICAL: Anti-virus/fake release protection
    # These formats block: .iso, .exe, .rar, password-protected files, and known fake patterns
    custom_formats:
      # Block unwanted content - ISOs, executables, low quality groups, extras
      - trash_ids:
          - ed38b889b31be83fda192888e2286d83  # BR-DISK (blocks .iso files)
          - 90a6f9a284dff5103f6346090e6280c8  # LQ (blocks .exe, bad groups)
          - e204b80c87be9497a8a6eaff48f72905  # LQ (Release Title - suspicious naming)
          - b8cd450cbfa689c0259a01d9e29ba3d6  # 3D
          - 0a3f082873eb454bde444150b70253cc  # Extras (sample files, executables)
          - bfd8eb01832d646a0a89c4deb46f8564  # Upscaled
          - 9c38ebb7384dada637be8899efa68e6f  # SDR (No WEBDL)
          - ae9b7c9ebde1f3bd336a8cbd1ec4c5e5  # No-RlsGroup (no proper release group)
        assign_scores_to:
          - name: HD+
            score: -10000  # Completely block these
          - name: Ultra-HD
            score: -10000
      
      # Block x265 HD (often low quality/fake)
      - trash_ids:
          - ff5bc9e8ce91d46c997ca3ac6994d6f8  # x265 (HD)
          - dc98083864ea246d05a42df0d05f81cc  # x265 (no HDR/DV)
        assign_scores_to:
          - name: HD+
            score: -10000
      
      # Prefer known good release groups
      - trash_ids:
          - ed27ebfef2f323e964fb1f61391bcb35  # HD Bluray Tier 01
          - c20c8647f2746a1f4c4262b0fbbeeeae  # HD Bluray Tier 02
          - 5608c71bcebba0a5e666223bae8c9227  # HD Bluray Tier 03
          - c20f169ef63c5f40c2def54abaf4438e  # WEB Tier 01
          - 403816d65392c79236dcb6dd591aeda4  # WEB Tier 02
        assign_scores_to:
          - name: HD+
            score: 1500
          - name: Ultra-HD
            score: 1500
